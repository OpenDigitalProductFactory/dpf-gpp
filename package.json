{
  "name": "@opendigitalproductfactory/dpf-gpp",
  "version": "0.1.0-candidate.2",
  "private": true,
  "type": "module",
  "description": "GPP shape schema, compiler and model tooling",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenDigitalProductFactory/dpf-gpp.git"
  },
  "engines": {
    "node": "24.16.0 || 24.22.0"
  },
  "scripts": {
    "verify:source": "node scripts/verify-provenance.mjs",
    "test": "node scripts/check-baseline.mjs",
    "check": "npm run verify:source && npm run build && npm run test:package",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test:package": "node scripts/check-package.mjs"
  },
  "dependencies": {
