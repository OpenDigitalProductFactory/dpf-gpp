  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "PROVENANCE.json",
    "IMPORT-MIGRATION.json",
    "DEPENDENCY-BOUNDARY.json",
    "MIGRATION.md",
    "examples/gpp-toolkit/NOTICE",
    "examples/gpp-toolkit/LICENSE"
