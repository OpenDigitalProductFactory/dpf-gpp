  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "6.0.3",
    "undici-types": "8.9.0"
  },
  "main": "./dist/validators/src/gpp/browser.js",
  "types": "./dist/validators/src/gpp/browser.d.ts",
  "exports": {
    ".": {
      "types": "./dist/validators/src/gpp/browser.d.ts",
