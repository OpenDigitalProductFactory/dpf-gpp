{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "types": [
      "node"
    ],
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "noEmitOnError": true,
    "skipLibCheck": false,
    "rootDir": "packages",
    "outDir": "dist"
  },
  "include": [
    "packages/**/*.ts"
  ]
}
